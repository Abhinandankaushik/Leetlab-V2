# Production build for the frontend SPA.
# This image is a ONE-SHOT builder: it compiles the Vite app and copies the
# static output into a shared volume (/output) that Caddy then serves.
# VITE_* values are read at build time from the environment (set in compose).
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# Build with the env vars injected by docker compose, then publish the static
# files into the mounted /output volume.
CMD ["sh", "-c", "npm run build && rm -rf /output/* && cp -r dist/* /output/"]
