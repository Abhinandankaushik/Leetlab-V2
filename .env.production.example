# Copy this file to .env on the server and fill in real values:
#   cp .env.production.example .env
# docker compose -f docker-compose.prod.yml automatically reads .env

# Your domain (DNS A record must point to the droplet's public IP).
# Caddy uses this to auto-issue a free HTTPS certificate.
DOMAIN=leetlab.example.com

# Public URLs derived from the domain above.
PUBLIC_URL=https://leetlab.example.com
WS_PUBLIC_URL=wss://leetlab.example.com/ws

# Managed Postgres connection string from Neon (https://neon.tech).
# Copy the "Pooled connection" string from the Neon dashboard and keep
# ?sslmode=require at the end (Prisma needs SSL to talk to Neon).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# JWT signing secret — must be at least 32 random characters.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Code-execution languages to warm at boot (comma-separated).
# Valid values: python, node, java, gcc   (gcc runs both C and C++)
# Add more later, e.g. EXECUTOR_LANGUAGES=python,gcc,java,node
EXECUTOR_LANGUAGES=python,gcc

# Optional: Clerk social login (Google / GitHub). Leave empty to disable.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
